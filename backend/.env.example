ML_MODEL_PATH=./app/ml/artifacts/model.pkl
ML_VERSION_PATH=./app/ml/artifacts/version.json

# Blockchain (optional — leave blank to disable audit recording)
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
REPORTER_PRIVATE_KEY=0xYOUR_WALLET_PRIVATE_KEY_HERE
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
CHAIN_ID=11155111
ETHERSCAN_URL=https://sepolia.etherscan.io

# App
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
MAX_UPLOAD_ROWS=10000
