# ─── Backend (services/api) ───────────────────────────────────
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres
ML_SERVICE_URL=http://localhost:8000
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-chars
REPORTER_PRIVATE_KEY=0xYOUR_SEPOLIA_WALLET_PRIVATE_KEY
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
CHAIN_ID=11155111
RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
ETHERSCAN_URL=https://sepolia.etherscan.io

# ─── ML Service (services/ml) ─────────────────────────────────
ML_PORT=8000
MODEL_PATH=../../ml/artifacts/model.pkl
VERSION_PATH=../../ml/artifacts/version.json

# ─── Frontend (apps/web) — prefix VITE_ ───────────────────────
VITE_API_URL=http://localhost:3001
VITE_CHAIN_ID=11155111
VITE_ETHERSCAN_URL=https://sepolia.etherscan.io
VITE_DEMO_MODE=true
